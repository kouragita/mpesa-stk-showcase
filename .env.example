# M-PESA PRODUCTION ENVIRONMENT TEMPLATE
# Copy this to .env.local and fill in your actual values

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true

# M-Pesa LIVE/PRODUCTION Credentials
MPESA_CONSUMER_KEY=your_consumer_key_from_daraja_portal
MPESA_CONSUMER_SECRET=your_consumer_secret_from_daraja_portal
MPESA_SHORTCODE=your_paybill_or_till_number
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_ENV=production 
MPESA_CALLBACK_URL=https://webhook.site/your-unique-url 
 

# JWT Secret for Authentication
JWT_SECRET=generate_a_long_random_string


# FOR SANDBOX TESTING (uncomment these and comment production values above)
# MPESA_CONSUMER_KEY=your_sandbox_consumer_key
# MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret  
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# MPESA_ENV=sandbox
# MPESA_CALLBACK_URL=https://your-public-url.example.com/api/mpesa/callback
